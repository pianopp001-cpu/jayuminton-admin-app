<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:background="#F8FAFC">

        <TextView
            android:id="@+id/selectedMemberText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="8dp"
            android:text="알림 받을 이름이 선택되지 않았습니다."
            android:textColor="#182033"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginEnd="6dp"
            android:padding="0dp"
            android:text="↻"
            android:textAllCaps="false"
            android:textSize="22sp"
            android:textStyle="bold"
            android:contentDescription="사용자 화면 새로고침" />

        <Button
            android:id="@+id/selectMemberButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="108dp"
            android:text="내 이름 선택"
            android:textAllCaps="false"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
