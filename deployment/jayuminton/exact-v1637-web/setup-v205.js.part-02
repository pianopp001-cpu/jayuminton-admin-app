        persistEngagementSeconds();
        refreshInstallState();
        if (engagementSeconds >= MIN_INSTALL_ENGAGEMENT_SECONDS) scheduleInstallabilityRecheck();
      }
    }, 1000);
  }

  function stopEngagementClock() {
    if (!engagementTimer) return;
    clearInterval(engagementTimer);
    engagementTimer = null;
  }

  function persistEngagementSeconds() {
    try { localStorage.setItem(STORAGE.engagementSeconds, String(Math.max(0, Math.min(MIN_INSTALL_ENGAGEMENT_SECONDS, engagementSeconds)))); } catch (_) {}
  }

  function installPreparationRemaining() {
    return Math.max(0, MIN_INSTALL_ENGAGEMENT_SECONDS - Math.floor(engagementSeconds));
  }


  function setInstallIntentArmed(value) {
    installIntentArmed = Boolean(value);
    try {
      if (installIntentArmed) sessionStorage.setItem('jayuminton_pwa_install_armed_v206', '1');
      else sessionStorage.removeItem('jayuminton_pwa_install_armed_v206');
    } catch (_) {}
  }

  function scheduleInstallabilityRecheck() {
    if (!androidDevice || embeddedBrowser || deferredInstallPrompt || isStandaloneApp()) return;
    if (!installIntentArmed || installPreparationRemaining() > 0) return;
    // Never reload or reopen Chrome here. Chrome dispatches beforeinstallprompt when
    // the current top-level page becomes installable. Reloading destroyed the pending
    // state and made the visible OFF button loop forever.
    consumeEarlyInstallPrompt();
    setInstallMessage('Chrome 설치 가능 신호를 기다리고 있습니다.', 'success');
    sendAppInstallStatus('설치 가능 신호 대기');
    refreshInstallState();
  }

  function supportsNativeInstallElement() {
    // The <install> element is an origin-trial feature. This site does not rely on it.
    return false;
  }

  function supportsNavigatorInstall() {
    // navigator.install() is also an origin-trial feature. Use the stable
    // beforeinstallprompt flow so the button never reports false readiness.
    return false;
  }

  function handleNativeInstallAction() {
    installAttemptPending = true;
    setInstallIntentArmed(false);
    setInstallMessage('설치 완료 신호를 확인하고 있습니다.', 'success');
    sendAppInstallStatus('설치 확인중');
    refreshInstallState();
  }

  function handleNativeInstallDismiss() {
    installAttemptPending = false;
    setInstallIntentArmed(false);
    const detail = '앱 설치가 취소되었습니다.';
    setInstallMessage(detail);
    sendAppInstallStatus(detail);
    refreshInstallState();
  }

  function handleNativeInstallValidation(event) {
    const reason = String((event && event.target && event.target.invalidReason) || '');
    if (!reason) return;
    installAttemptPending = false;
    sendAppInstallStatus('설치 준비 확인 중');
    refreshInstallState();
  }

  async function ensureChromeInstallControl() {
    if (!androidDevice || embeddedBrowser || isStandaloneApp()) return;
    try {
      await prepareServiceWorker();
      consumeEarlyInstallPrompt();
      refreshInstallState();
    } catch (_) {
      refreshInstallState();
    }
  }

  function handleDirectInstallProxyClick(event) {
    // This is a real top-level BUTTON, not an <a href="#">. Always consume the tap so
    // Chrome can never navigate, refresh, or reopen the current page by default.
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }
    if (androidDevice && embeddedBrowser) {
      setInstallMessage('Chrome에서 자유민턴 코트현황을 여는 중입니다.', 'success');
      sendAppInstallStatus('Chrome으로 이동');
      openInAndroidChrome();
      return;
    }
    handleAppInstallButton(true);
  }

  function handleAppInstallButton(fromDirectUserTap) {
    if (isUserAppInstalledState()) {
      markAppDownloadOn();
      showToast('자유민턴 코트현황 앱이 이미 설치되어 있습니다.');
      collapseSetupAfterSuccess();
      return;
    }

    if (androidDevice && embeddedBrowser) {
      const detail = 'Chrome에서 설치 화면을 준비합니다.';
      setInstallMessage(detail, 'success');
      sendAppInstallStatus(detail);
      showToast('Chrome으로 이동합니다.');
      openInAndroidChrome();
      return;
    }

    if (iosDevice && embeddedBrowser) {
      const detail = 'Safari에서 설치 화면을 엽니다.';
      setInstallMessage(detail, 'success');
      sendAppInstallStatus(detail);
      showToast('Safari로 이동합니다.');
      openInIOSSafari();
      return;
    }

    if (iosDevice) {
      showIOSInstallGuide();
      return;
    }
    if (androidDevice) {
      if (deferredInstallPrompt) {
        installAndroidUserApp(Boolean(fromDirectUserTap));
        return;
      }
      if (supportsNavigatorInstall()) {
        installWithNavigatorApi(Boolean(fromDirectUserTap));
        return;
      }
      if (supportsNativeInstallElement()) {
        setInstallIntentArmed(true);
        refreshInstallState();
        return;
      }
      // Real Android Chrome: never open another window and never reload.
      // Wait on this page for beforeinstallprompt, then this same button calls prompt().
      setInstallIntentArmed(true);
      startEngagementClock();
      const remaining = installPreparationRemaining();
      if (remaining <= 0) scheduleInstallabilityRecheck();
      const detail = remaining > 0
        ? 'PWA 설치 준비 ' + remaining + '초'
        : '설치 준비 중입니다. 버튼이 PWA 설치로 바뀌면 한 번 눌러 주세요.';
      setInstallMessage(detail, 'success');
      sendAppInstallStatus(detail);
      refreshInstallState();
      return;
    }
    const detail = '현재 브라우저 메뉴에서 앱 설치 또는 홈 화면에 추가를 선택해 주세요.';
    setInstallMessage(detail, 'error');
    sendAppInstallStatus(detail);
  }

  async function installWithNavigatorApi(fromDirectUserTap) {
    if (!fromDirectUserTap) {
      sendAppInstallStatus('설치 버튼 직접 터치 필요');
      return;
    }
    installAttemptPending = true;
    setInstallIntentArmed(false);
    setInstallMessage('시스템 설치창을 여는 중입니다.', 'success');
    sendAppInstallStatus('설치창 여는 중');
    refreshInstallState();
    try {
      const result = await navigator.install();
      installAttemptPending = true;
      setInstallMessage('설치 완료 신호를 확인하고 있습니다.', 'success');
      sendAppInstallStatus('설치 확인중');
      if (result && (result.outcome === 'dismissed' || result === false)) {
        handleNativeInstallDismiss();
      }
    } catch (error) {
      installAttemptPending = false;
      const detail = 'Chrome이 설치 요청을 허용하지 않았습니다.';
      setInstallMessage(detail, 'error');
      sendAppInstallStatus(detail);
      refreshInstallState();
    }
  }

  function installAndroidUserApp(fromDirectUserTap) {
    if (!deferredInstallPrompt) {
      installAttemptPending = false;
      const detail = 'PWA 설치 준비가 아직 끝나지 않았습니다. 준비가 완료되면 버튼이 PWA 설치로 바뀝니다.';
      setInstallMessage(detail);
      sendAppInstallStatus(detail);
      showToast(detail);
      prepareServiceWorker().then(() => ensureChromeInstallControl()).catch(() => null);
      refreshInstallState();
      return;
    }

    if (!fromDirectUserTap) {
      const detail = '설치 버튼의 직접 터치가 필요합니다. 앱설치 버튼을 다시 눌러 주세요.';
      setInstallMessage(detail, 'error');
      sendAppInstallStatus(detail);
      showToast(detail);
      return;
    }

    const promptEvent = deferredInstallPrompt;
    deferredInstallPrompt = null;
    installAttemptPending = true;
    clearTimeout(installAttemptTimer);
    setInstallMessage('설치 확인창에서 설치를 눌러 주세요.', 'success');
    sendAppInstallStatus('설치 확인창을 표시했습니다.');
    refreshInstallProxyPosition();

    let promptResult;
    try {
      // Must run synchronously inside the top-level button's user action.
      promptResult = promptEvent.prompt();
    } catch (error) {
      installAttemptPending = false;
      const detail = 'Chrome이 시스템 설치창 요청을 허용하지 않았습니다.';
      setInstallMessage(detail, 'error');
      sendAppInstallStatus(detail);
      showToast(detail);
      refreshInstallState();
      return;
    }

    Promise.resolve(promptResult)
      .then((result) => {
        if (result && result.outcome) return result;
        return promptEvent.userChoice || {outcome:'dismissed'};
      })
      .then((choice) => {
        if (choice && choice.outcome === 'accepted') {
          installAttemptPending = true;
          setInstallMessage('설치 완료 신호를 확인하고 있습니다.', 'success');
          sendAppInstallStatus('설치 확인중');
          showToast('설치가 완료되면 앱설치 ON으로 바뀝니다.');
          installAttemptTimer = window.setTimeout(() => {
            if (!isUserAppInstalledState()) {
              installAttemptPending = false;
              const detail = '설치 완료 신호가 확인되지 않았습니다. 홈 화면에 앱이 생겼는지 확인해 주세요.';
              setInstallMessage(detail, 'error');
              sendAppInstallStatus(detail);
              refreshInstallState();
            }
          }, 15000);
        } else {
          installAttemptPending = false;
          const detail = '앱 설치가 취소되었습니다.';
          setInstallMessage(detail);
          sendAppInstallStatus(detail);
          showToast(detail);
          refreshInstallState();
        }
      })
      .catch(() => {
        installAttemptPending = false;
        const detail = '설치 결과를 확인하지 못했습니다.';
        setInstallMessage(detail, 'error');
        sendAppInstallStatus(detail);
        showToast(detail);
        refreshInstallState();
      });
  }

  function buildChromeUserTarget() {
    const target = new URL('https://jayuminton-push.web.app/');
    target.searchParams.set('install', 'choose');
    target.searchParams.set('external', '1');
    target.searchParams.set('source', 'chrome');
    target.searchParams.set('app', 'user');
    target.searchParams.set('mode', 'user');
    if (member && member.id) target.searchParams.set('memberId', String(member.id));
    if (member && member.name) target.searchParams.set('memberName', String(member.name));
    const authSession = String(localStorage.getItem(STORAGE.authSession) || transferredMemberSession || '');
    if (authSession) target.searchParams.set('memberSession', authSession);
    return target;
  }

  function buildAndroidChromeIntent() {
    const target = buildChromeUserTarget();
    const targetUrl = target.toString();
    const hostAndPath = target.host + target.pathname + target.search + target.hash;
    // Do not attach browser_fallback_url here. Some Kakao/Daangn WebViews misroute the
    // encoded fallback to Google Drive. The package is fixed to the installed Chrome app.
    const intentUrl = 'intent://' + hostAndPath +
      '#Intent;scheme=https;package=com.android.chrome;action=android.intent.action.VIEW;' +
      'category=android.intent.category.BROWSABLE;end';
    return { targetUrl, intentUrl };
  }

  function launchChromeFromFirebaseTop() {
    const links = buildAndroidChromeIntent();
    const hasActivation = !navigator.userActivation || navigator.userActivation.isActive;
    if (!hasActivation) {
      setInstallMessage('앱설치 버튼을 다시 눌러 Chrome으로 이동해 주세요.', 'error');
      sendAppInstallStatus('Chrome 직접 터치 필요');
      return;
    }
    // Backup only. In Kakao/Daangn the transparent top-level <a> handles the real tap.
    window.location.href = links.intentUrl;
  }

  function openInAndroidChrome() {
    launchChromeFromFirebaseTop();
  }

  function openInIOSSafari() {
    const target = new URL(window.location.href);
    target.searchParams.set('install', 'choose');
    target.searchParams.set('external', '1');
    target.searchParams.set('source', 'embedded');
    target.searchParams.set('app', 'user');
    target.searchParams.set('mode', 'user');
    const authSession = String(localStorage.getItem(STORAGE.authSession) || '');
    if (authSession) target.searchParams.set('memberSession', authSession);
    const safariTarget = 'x-safari-https://' + target.host + target.pathname + target.search + target.hash;
    window.location.href = safariTarget;
    window.setTimeout(() => {
      showToast('Safari가 열리지 않으면 우측 상단 메뉴에서 Safari로 열기를 선택하세요.');
      sendAppInstallStatus('Safari로 열기');
    }, 900);
  }

  function handleUserAppInstalled() {
    deferredInstallPrompt = null;
    installAttemptPending = false;
