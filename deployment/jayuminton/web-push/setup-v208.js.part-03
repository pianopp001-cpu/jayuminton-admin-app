);
    nativeInstallControl.addEventListener('promptdismiss', handleNativeInstallDismiss);
    nativeInstallControl.addEventListener('validationstatuschanged', handleNativeInstallValidation);
  }
  window.addEventListener('beforeinstallprompt', captureAndroidInstallPrompt);
  window.addEventListener('jayuminton:installpromptready', consumeEarlyInstallPrompt);
  window.addEventListener('appinstalled', handleUserAppInstalled);
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.addEventListener('controllerchange', () => {
      consumeEarlyInstallPrompt();
      refreshInstallState();
    });
  }
  window.addEventListener('message', handleCourtMessage);
  window.addEventListener('resize', refreshInstallProxyPosition, {passive:true});
  window.addEventListener('scroll', refreshInstallProxyPosition, {passive:true});
  frame.addEventListener('load', () => {
    window.setTimeout(() => {
      syncStandaloneInstallState();
      sendBootstrap();
      refreshInstallProxyPosition();
    }, 120);
  });
  window.addEventListener('pageshow', () => {
    syncStandaloneInstallState();
    refreshInstallState();
  });
  const standaloneMedia = window.matchMedia('(display-mode: standalone)');
  if (standaloneMedia && typeof standaloneMedia.addEventListener === 'function') {
    standaloneMedia.addEventListener('change', () => {
      syncStandaloneInstallState();
      refreshInstallState();
      sendBootstrap();
    });
  }
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) {
      syncStandaloneInstallState();
      refreshConnectionState();
      refreshInstallState();
      startEngagementClock();
    } else {
      stopEngagementClock();
    }
  });

  consumeEarlyInstallPrompt();
  startEngagementClock();
  prepareServiceWorker()
    .then(() => ensureChromeInstallControl())
    .catch(() => null);
  configureSetupPanel();
  refreshDirectInstallScreen();
  refreshInstallState();
  refreshConnectionState();
  if ((installationEntryRequested || externalBrowserEntry) && !isStandaloneApp()) {
    window.setTimeout(() => {
      if (androidDevice && !embeddedBrowser) {
        showToast('Chrome에서 PWA 설치 가능 상태를 확인하고 있습니다.');
      } else if (iosDevice && browserContext === 'ios-safari') {
        showToast('Safari에서 바로 사용할 수 있습니다. 앱설치를 누르면 홈 화면 추가 방법이 표시됩니다.');
      }
    }, 700);
  }

  function configureSetupPanel() {
    setSetupCollapsed(true, false);
    setupPanel.hidden = true;
    setupPanel.setAttribute('aria-hidden', 'true');
    setupPanel.style.setProperty('display', 'none', 'important');
    setupPanel.classList.add('hidden-infrastructure');
  }

  function setSetupCollapsed(collapsed, remember) {
    setupPanel.classList.toggle('is-collapsed', Boolean(collapsed));
    setupToggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
    if (remember) localStorage.setItem(STORAGE.setupCollapsed, collapsed ? '1' : '0');
  }

  function collapseSetupAfterSuccess() {
    window.setTimeout(() => setSetupCollapsed(true, true), 500);
  }

  function handleAlarmButton() {
    if (isConnected) disconnectAlarm();
    else connectAlarm();
  }

  async function connectAlarm() {
    if (iosDevice && !isStandaloneApp()) {
      setSetupCollapsed(false, true);
      setMessage('아이폰은 먼저 아이폰 전용앱 다운 버튼을 눌러 홈 화면에 설치한 뒤, 설치된 앱에서 완료를 눌러 주세요.', 'error');
      showIOSInstallGuide();
      return;
    }
    if (!members.length) {
      setMessage('회원 명단을 불러오는 중입니다. 잠시 후 다시 눌러 주세요.', 'error');
      return;